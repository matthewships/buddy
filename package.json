{
  "name": "buddy",
  "private": true,
  "version": "0.1.0",
  "description": "Buddy \u2014 accountability buddies, daily tasks, peer review.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @buddy/api",
    "dev:mobile": "npm run start --workspace @buddy/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
