{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddy-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  // OpenNext's runtime needs both: `nodejs_compat` for the Node built-ins Next
  // pulls in, and `global_fetch_strictly_public` so a fetch to our own hostname
  // leaves the Worker instead of looping back into it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // No vars and no bindings: the API URL is inlined into the client bundle at
  // build time by next.config.ts, so nothing here is read at runtime. The web
  // Worker holds no secrets and touches no D1, KV or R2 — it serves assets.
}
