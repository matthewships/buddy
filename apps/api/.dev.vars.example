# Copy to .dev.vars for local `wrangler dev`. .dev.vars is gitignored.
# Overrides the deployed ENVIRONMENT so verification codes are logged locally
# instead of requiring a working email sender.
ENVIRONMENT="development"
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET="replace-me-with-32-random-bytes-hex"
# Only needed once push is wired (phase 4)
# EXPO_ACCESS_TOKEN=""
# Guards the /admin/* endpoints. Without it, those endpoints are closed, not open.
# ADMIN_TOKEN="replace-me-with-32-random-bytes-hex"
# Browser push (§4.6). Generate a dev-only pair with:
#   node scripts/vapid-keys.mjs
# Without them the API sends no browser notifications; everything else works.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
