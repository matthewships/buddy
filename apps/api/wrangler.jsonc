{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buddy",
      "database_id": "9cac77ca-1f50-4036-a470-0211dfa7c753",
      "migrations_dir": "drizzle"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8a946df02c8b4308b4266b3a191b4bec"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "buddy-media"
    }
  ],

  // Hourly day rollover (§4.9): marks lapsed `planned` tasks missed and breaks
  // streaks. Hourly rather than daily because local midnight lands on a
  // different UTC hour in every timezone.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Push delivery (§4.6). The Worker is both producer (routes enqueue) and
  // consumer (the queue handler batches to Expo).
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "buddy-push"
      }
    ],
    "consumers": [
      {
        "queue": "buddy-push",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // Sends verification and password-reset codes. The binding only works once
  // localrack.xyz is onboarded to Email Service in the dashboard (SPF + DKIM);
  // until then services/email.ts logs codes instead of failing.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    "EMAIL_FROM": "no-reply@localrack.xyz",
    "EMAIL_FROM_NAME": "Buddy"
  }

  // Bindings added in later phases, kept here as a checklist so the shape of
  // the finished Worker stays visible:
  //   GROUP_CHAT  Durable Object class GroupChat   -> phase 4 (§4.7)
  //   RATE_LIMITER Rate limiting binding           -> phase 1 (§4.3)
  //   AI          Workers AI                       -> phase 2, optional (§1)
  //   triggers.crons weekly leaderboard snapshot   -> phase 5 (§4.9)
  // Secrets (wrangler secret put): JWT_SECRET, EXPO_ACCESS_TOKEN, ADMIN_TOKEN
}
