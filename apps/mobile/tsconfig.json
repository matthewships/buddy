{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Listed explicitly: TypeScript 6 does not auto-include @types from the
    // workspace root here, and being explicit keeps unrelated global types
    // (jsdom, chai) out of the React Native program. Expo's own ambient types
    // arrive through the /// reference in expo-env.d.ts.
    "types": ["jest"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
