{
  "expo": {
    "name": "Buddy",
    "slug": "buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "buddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.buddyapp.buddy",
      "supportsTablet": false
    },
    "android": {
      "package": "com.buddyapp.buddy"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8787"
    }
  }
}
